# Server
PORT=4001
NODE_ENV=development
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=scello_be_task_manager
TEST_DB_NAME=scello_be_task_manager_test
PROD_DB_NAME=scello_be_task_manager

# Database connection pool (tune for expected concurrency)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
SQL_LOGGING=false

# Auth
JWT_SECRET=change-me

# CORS - comma-separated list of allowed origins, e.g. "https://app.example.com,https://admin.example.com"
# Omit (or leave blank) to allow all origins (fine for local dev, not for production).
CORS_ORIGIN=

# Request limits
BODY_LIMIT=100kb

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
